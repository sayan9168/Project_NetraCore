# ── Netra-Core environment template ─────────────────────────────────
# Copy to `.env` (project root or config/environments/) and fill secrets.
# NEVER commit real secrets — `.env` is git-ignored.

# Identity
ENV=development
LOG_LEVEL=INFO

# Paths (relative to project root unless absolute)
NETRA_VAULT_DB=data/netra_vault.db
NETRA_LEGAL_DB=data/legal_knowledge.db
NETRA_AUDIT_DIR=logs/audit
NETRA_REPORT_DIR=data/reports
NETRA_THREAT_FEED=data/threat_feed.json

# ── Security ──────────────────────────────────────────────────────
# Empty = dev mode (X-Agent-ID trusted). Set in production!
# Format: comma-separated secrets, optionally prefixed with agent id.
NETRA_API_KEYS=analyst-01:change-me-analyst-secret
NETRA_ADMIN_KEYS=admin-01:change-me-admin-secret
NETRA_TOKEN_SECRET=change-me-to-32-plus-random-bytes
NETRA_TOKEN_TTL=3600
NETRA_ENFORCE_WARRANT_EXPIRY=true
# Comma-separated, e.g. https://soc.example.gov
NETRA_CORS_ORIGINS=

# ── Orchestrator ──────────────────────────────────────────────────
NETRA_MODULE_TIMEOUT=120
NETRA_MODULE_RETRIES=1
NETRA_MAX_EVIDENCE_MB=8

# ── Cache / queue ─────────────────────────────────────────────────
# Empty = in-memory cache. Example: redis://:pass@redis:6379/0
REDIS_URL=
NETRA_CACHE_TTL=300

# ── Observability ─────────────────────────────────────────────────
# Empty = console exporter. Example: http://otel-collector:4317
OTLP_ENDPOINT=

# ── AWS Cloud Auditor (Module C) ──────────────────────────────────
# Empty = documented simulation mode.
AWS_AUDIT_ROLE_ARN=
AWS_EXTERNAL_ID=
AWS_SCAN_REGIONS=us-east-1,ap-south-1

# ── Rate limits ───────────────────────────────────────────────────
NETRA_RL_INTAKE=30/minute
NETRA_RL_READ=60/minute
NETRA_RL_REPORT=5/minute
